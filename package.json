{
  "name": "movido-driver",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings test/run.ts",
    "doctor": "expo-doctor",
    "export:check": "expo export --platform android --platform ios --output-dir dist",
    "build:preview": "eas build --profile preview --platform all",
    "build:production": "eas build --profile production --platform all",
    "test:ui": "MOVIDO_UI_TEST=1 expo export --platform web --output-dir test/ui/dist && node test/ui/run.mjs",
    "test:unit": "node --experimental-strip-types --no-warnings test/position.test.ts && node --experimental-strip-types --no-warnings test/push.test.ts && node --experimental-strip-types --no-warnings test/outbox.test.ts && node --experimental-strip-types --no-warnings test/gpsQueue.test.ts && node --experimental-strip-types --no-warnings test/photoUpload.test.ts && node --experimental-strip-types --no-warnings test/pushPrompt.test.ts"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.117.2",
    "expo": "~57.0.25",
    "expo-application": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.20",
    "lucide-react-native": "^1.48.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-signature-canvas": "^5.1.1",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@types/node": "^22.20.4",
    "@types/react": "~19.2.4",
    "react-dom": "19.2.3",
    "react-native-web": "^0.21.3",
    "typescript": "~6.0.3"
  }
}
